{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare ship portraits and review rotation controls",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoLogo", "-NoProfile", "-File", "${workspaceFolder}/tools/Prepare-StaticFleet.ps1", "-Review"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "close": false },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Check sensor panel 1.8.11 (no publish or install)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/Run-JenkinsChecks.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Review sensor panel CI candidate (no publish or install)",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoLogo", "-NoProfile", "-File", "${workspaceFolder}/tools/Complete-SensorRelease.ps1", "-Phase", "Review", "-BuildNumber", "${input:sensorReleaseBuild}", "-ExpectedSha", "${input:sensorReleaseSha}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Finalize accepted Anubis fleet (no install)",
      "dependsOn": [
        "Check Anubis main fleet (no install)",
        "Build Fleet Studio"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Check fleet light glow (no install)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/tools/Check-FleetLightGlow.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Check Anubis bow candidate (no install)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/tools/Check-AnubisAdoption.py",
        "--candidate"
      ],
      "dependsOn": "Assemble Anubis source review (offline only)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Correct Anubis interior bow glow (no install)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/tools/Adopt-Anubis.py",
        "--correct-bow"
      ],
      "dependsOn": "Check Anubis bow candidate (no install)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Finish Anubis bow light in main fleet (no install)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/tools/Adopt-Anubis.py",
        "--finish-bow"
      ],
      "dependsOn": "Assemble Anubis source review (offline only)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Check Anubis main fleet (no install)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/tools/Check-AnubisAdoption.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Adopt Anubis into main fleet (no install)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/tools/Adopt-Anubis.py"
      ],
      "dependsOn": "Assemble Anubis source review (offline only)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Assemble Anubis source review (offline only)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/Sources/Anubis/prepare-review.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare Anubis Fleet Studio review",
      "dependsOn": [
        "Check Anubis bow candidate (no install)",
        "Build Fleet Studio"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Render Roci colour candidate (offline only)",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}/output/rocinante-colour-finish-20261020/run-study.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Validate X890 CI gates (no install)",
      "type": "shell",
      "command": "& './tools/Run-JenkinsChecks.ps1'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build X890 release installer (no install)",
      "type": "shell",
      "command": "& './tools/Build-Installer.ps1'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Check desktop fleet assets",
      "type": "shell",
      "command": "python",
      "args": [
        "./tools/Sync-FleetViewer.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build desktop panel (no launch)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "./SensorPanel/SensorPanel.csproj",
        "-c",
        "Release"
      ],
      "dependsOn": "Check desktop fleet assets",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Validate holographic sensor panel",
      "type": "shell",
      "command": "& './tools/Validate-Holotable.ps1'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build X890 monitor",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SensorPanel/SensorPanel.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build Fleet Studio",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/FleetStudio.Desktop/FleetStudio.Desktop.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run X890 monitor (live)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/SensorPanel/SensorPanel.csproj",
        "--",
        "--windowed"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Fleet Studio",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/FleetStudio.Desktop/FleetStudio.Desktop.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    { "id": "sensorReleaseBuild", "type": "promptString", "description": "Successful X890-CI installer build number for the approved candidate" },
    { "id": "sensorReleaseSha", "type": "promptString", "description": "Full 40-character pushed source SHA for that exact CI build" }
  ]
}
