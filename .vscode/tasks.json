{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate X890 CI gates (no install)",
      "type": "shell",
      "command": "& './tools/Run-JenkinsChecks.ps1'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "close": false },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build X890 release installer (no install)",
      "type": "shell",
      "command": "& './tools/Build-Installer.ps1'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "close": false },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Check desktop fleet assets",
      "type": "shell",
      "command": "python",
      "args": [
        "./tools/Sync-FleetViewer.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build desktop panel (no launch)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "./SensorPanel/SensorPanel.csproj",
        "-c",
        "Release"
      ],
      "dependsOn": "Check desktop fleet assets",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Validate holographic sensor panel",
      "type": "shell",
      "command": "& './tools/Validate-Holotable.ps1'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "close": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build X890 monitor",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SensorPanel/SensorPanel.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build Fleet Studio",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/FleetStudio.Desktop/FleetStudio.Desktop.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run X890 monitor (live)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/SensorPanel/SensorPanel.csproj",
        "--",
        "--windowed"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Fleet Studio",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/FleetStudio.Desktop/FleetStudio.Desktop.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
