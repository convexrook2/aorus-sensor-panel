# Preserve generated GLSL and unified-patch context exactly.
Assets/SolarNavigation/assets/** -text -whitespace
tools/PresentMon/*.patch text eol=lf -whitespace

# Bundled upstream Three.js stays versioned without enormous dependency diffs.
Assets/FleetViewer/vendor/** -diff linguist-vendored=true
FleetStudio/vendor/** -diff linguist-vendored=true

# The desktop bundle manifest hashes exact file bytes across platforms.
Assets/FleetViewer/** -text whitespace=cr-at-eol

# The same effect module is copied into both source bundles and checked bytewise.
FleetStudio/ship-effects.js text eol=lf
