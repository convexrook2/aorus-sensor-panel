<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>../Assets/Branding/AorusFanMade.ico</ApplicationIcon>
    <Version>1.8.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>false</SelfContained>
    <RollForward>LatestPatch</RollForward>
    <Product>AORUS Sensor Panel - FAN MADE</Product>
    <Description>Independent fan-made AORUS hardware sensor panel</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Preserve the prior web adaptation in source; the original native diagram is primary. -->
    <Compile Remove="BelterSystemView.cs" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="../Assets/Branding/AorusFanMade.ico" Link="Branding/AorusFanMade.ico" />
    <Resource Include="../Assets/Ships/*.jpg" Link="Ships/%(Filename)%(Extension)" />
    <Resource Include="../Assets/Models/*.ship" Link="Models/%(Filename)%(Extension)" />
    <Content Include="../Assets/Models/ATTRIBUTION.txt" Link="Holotable-Model-Credits.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Packaging/README.txt" Link="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/Expanse/README.md" Link="Expanse-Media-Guide.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/SolarNavigation/textures/*" Link="SolarNavigation/textures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/SolarNavigation/nasa-horizons.json.gz" Link="SolarNavigation/nasa-horizons.json.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/SolarNavigation/nasa-checkpoints.json" Link="SolarNavigation/nasa-checkpoints.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/SolarNavigation/models/eros.fnm;../Assets/SolarNavigation/models/phoebe.fnm;../Assets/SolarNavigation/models/tycho.fnm;../Assets/SolarNavigation/models/medina.fnm;../Assets/SolarNavigation/models/solgate.fnm" Link="SolarNavigation/models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/SolarNavigation/*.txt;../Assets/SolarNavigation/*.md" Link="SolarNavigation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/Ships/sources.json" Link="Ship-Artwork-Sources.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SensorCollector/SensorCollector.csproj" />
    <Resource Include="../Assets/AORUS/@Resources/Images/**/*.png" Link="Aorus/Images/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="../Assets/AORUS/@Resources/Fonts/*.ttf" Link="Aorus/Fonts/%(Filename)%(Extension)" />
    <Resource Include="../Assets/AORUS/@Resources/GIFs/L/*.png" Link="Aorus/Animations/L/%(Filename)%(Extension)" />
    <Resource Include="../Assets/AORUS/@Resources/GIFs/R/*.png" Link="Aorus/Animations/R/%(Filename)%(Extension)" />
    <Resource Include="../Assets/AORUS/@Resources/GIFs/GIF1/*.png" Link="Aorus/Animations/X/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CopyFrameViewBridge" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\SensorCollector\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\NvidiaFrameViewBridge.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="PublishFrameViewBridge" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)NvidiaFrameViewBridge.dll"
          DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
