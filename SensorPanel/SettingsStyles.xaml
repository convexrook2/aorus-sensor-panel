<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="SettingsTabsTemplate" TargetType="TabControl">
    <DockPanel>
      <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="0,0,0,4"
              BorderBrush="{DynamicResource SettingsDivider}" BorderThickness="0,0,0,1">
        <UniformGrid IsItemsHost="True" Rows="1" KeyboardNavigation.DirectionalNavigation="Cycle" />
      </Border>
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
    </DockPanel>
  </ControlTemplate>
  <Style x:Key="SettingsTabStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                  BorderThickness="1" CornerRadius="4" Padding="4,2">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SettingsHoverSurface}" />
              <Setter Property="Foreground" Value="{DynamicResource SettingsForeground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SettingsHoverSurface}" />
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource SettingsDivider}" />
              <Setter Property="Foreground" Value="{DynamicResource SettingsForeground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource SettingsFocus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="Button">
    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsFocus}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SettingsFocus}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="SettingsOptionStyle" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource SettingsOptionBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsOptionForeground}" />
    <Setter Property="Padding" Value="8,6,8,6" />
  </Style>
  <Style x:Key="SettingsPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SettingsPageButton}" /></Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource SettingsScrollThumb}" CornerRadius="3" /></ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SettingsPageButton}" /></Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
