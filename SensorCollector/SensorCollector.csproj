<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
    <RollForward>LatestPatch</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <None Include="../tools/PresentMon/PresentMon-2.6.0-x64.exe" Link="PresentMon-2.6.0-x64.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../tools/PresentMon/PresentMon-2.6.0-x890-compat-x64.exe" Link="PresentMon-2.6.0-x890-compat-x64.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../tools/PresentMon/COMPAT-NOTICES.txt" Link="PresentMon-COMPAT-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../tools/PresentMon/LICENSE.txt" Link="PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildFrameViewBridge" BeforeTargets="CoreCompile" Condition="'$(BuildFrameViewBridge)' == 'true'"
          Inputs="$(MSBuildProjectDirectory)\Native\FrameViewBridge.cpp;$(MSBuildProjectDirectory)\..\tools\Build-FrameViewBridge.ps1;C:\Program Files\NVIDIA Corporation\FrameViewSDK\SDK\Public_Release\FvSDK.h;C:\Program Files\NVIDIA Corporation\FrameViewSDK\SDK\Public_Release\FvSDK_x64.lib"
          Outputs="$(MSBuildProjectDirectory)\$(OutDir)NvidiaFrameViewBridge.dll">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\tools\Build-FrameViewBridge.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\$(OutDir).&quot;" />
  </Target>
</Project>
