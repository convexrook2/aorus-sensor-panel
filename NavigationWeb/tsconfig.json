{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true, "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
